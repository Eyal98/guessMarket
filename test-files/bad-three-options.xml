<?xml version="1.0" encoding="UTF-8"?>
<!-- Three outcomes. The system supports binary events only. -->
<Guess-Market>
    <GM-events>
        <GM-event name="Event With Three Outcomes">
            <id>1</id>
            <description>An event that cannot be answered with yes or no.</description>
            <comision type="on-close">10</comision>
            <GM-options>
                <GM-option>Yes</GM-option>
                <GM-option>No</GM-option>
                <GM-option>Maybe</GM-option>
            </GM-options>
            <GM-method>
                <GM-LMSR><b>100</b></GM-LMSR>
            </GM-method>
        </GM-event>
    </GM-events>
	<GM-users>
		<GM-user name="Tester">
			<initial-cash>100000</initial-cash>
			<GM-market-maker>
			<event id="1"/>
			</GM-market-maker>
		</GM-user>
	</GM-users>
</Guess-Market>
