<?xml version="1.0" encoding="UTF-8"?>
<!--
  A valid event of a kind this version cannot run: it trades through an order book rather than LMSR.
  The system should say so plainly rather than fail in some obscure way.
-->
<Guess-Market>
    <GM-events>
        <GM-event name="Order Book Event">
            <id>1</id>
            <description>An event traded through an order book, which arrives in a later version.</description>
            <comision type="on-close">10</comision>
            <GM-options>
                <GM-option>Yes</GM-option>
                <GM-option>No</GM-option>
            </GM-options>
            <GM-method>
                <GM-order-book allow-mint="true" initial="100" d="1"/>
            </GM-method>
        </GM-event>
    </GM-events>
</Guess-Market>
