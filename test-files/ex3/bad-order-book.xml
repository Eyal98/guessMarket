<?xml version="1.0" encoding="UTF-8"?>
<!-- An order book whose base value is zero and whose minting rule is neither true nor false. -->
<Guess-Market>
    <GM-events>
        <GM-event name="Broken Book">
            <description>Nothing about this book adds up.</description>
            <commission type="on-purchase">1</commission>
            <GM-options>
                <GM-option>Yes</GM-option>
                <GM-option>No</GM-option>
            </GM-options>
            <GM-method>
                <GM-order-book allow-mint="maybe" initial="100" d="0"/>
            </GM-method>
        </GM-event>
    </GM-events>
</Guess-Market>
