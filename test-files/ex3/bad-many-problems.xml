<?xml version="1.0" encoding="UTF-8"?>
<!--
  Four events, each broken in a different way, the last of them sharing its name with the first.
  Loading this file should produce one report listing every fault, not just the first one.
-->
<Guess-Market>
    <GM-events>
        <GM-event name="Commission Out Of Range">
            <description>The commission of this event is far too high.</description>
            <commission type="on-close">150</commission>
            <GM-options>
                <GM-option>Yes</GM-option>
                <GM-option>No</GM-option>
            </GM-options>
            <GM-method>
                <GM-LMSR><b>100</b></GM-LMSR>
            </GM-method>
        </GM-event>
        <GM-event name="A Single Option">
            <description>This event offers one answer, which is no choice at all.</description>
            <commission type="on-close">10</commission>
            <GM-options>
                <GM-option>Yes</GM-option>
            </GM-options>
            <GM-method>
                <GM-LMSR><b>100</b></GM-LMSR>
            </GM-method>
        </GM-event>
        <GM-event>
            <description>This event has no name attribute and no liquidity index.</description>
            <commission type="on-close">10</commission>
            <GM-options>
                <GM-option>Yes</GM-option>
                <GM-option>No</GM-option>
            </GM-options>
            <GM-method>
                <GM-LMSR><b></b></GM-LMSR>
            </GM-method>
        </GM-event>
        <GM-event name="COMMISSION OUT OF RANGE">
            <description>This event is sound in itself, but its name is already taken in this file.</description>
            <commission type="on-purchase">5</commission>
            <GM-options>
                <GM-option>Yes</GM-option>
                <GM-option>No</GM-option>
            </GM-options>
            <GM-method>
                <GM-LMSR><b>100</b></GM-LMSR>
            </GM-method>
        </GM-event>
    </GM-events>
</Guess-Market>
