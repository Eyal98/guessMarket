<!-- The liquidity index is a word rather than a number. -->
<Guess-Market>
    <GM-events>
        <GM-event name="Event With A Written Out Liquidity">
            <description>An event whose liquidity index was typed as a word.</description>
            <commission type="on-close">10</commission>
            <GM-options>
                <GM-option>Yes</GM-option>
                <GM-option>No</GM-option>
            </GM-options>
            <GM-method>
                <GM-LMSR><b>one hundred</b></GM-LMSR>
            </GM-method>
        </GM-event>
    </GM-events>
</Guess-Market>
