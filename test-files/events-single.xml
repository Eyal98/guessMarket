<?xml version="1.0" encoding="UTF-8"?>
<!--
  The smallest sound file there can be: one event, no commission at all. Also checks that surrounding
  whitespace inside elements is ignored, as the file format requires.
-->
<Guess-Market>
    <GM-events>
        <GM-event name="  Rain In Tel Aviv This Week  ">
            <id>1</id>
            <description>   Will more than one millimetre of rain be measured in Tel Aviv this week? Decided by the Israel Meteorological Service.   </description>
            <comision type="ON-PURCHASE">0</comision>
            <GM-options>
                <GM-option>  Yes  </GM-option>
                <GM-option>No</GM-option>
            </GM-options>
            <GM-method>
                <GM-LMSR>
                    <b>100</b>
                </GM-LMSR>
            </GM-method>
        </GM-event>
    </GM-events>
	<GM-users>
		<GM-user name="Tester">
			<initial-cash>100000</initial-cash>
			<GM-market-maker>
			<event id="1"/>
			</GM-market-maker>
		</GM-user>
	</GM-users>
</Guess-Market>
