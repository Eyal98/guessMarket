<Guess-Market>
    <GM-events>
        <GM-event name="Order Book Event">
            <id>1</id>
            <description>An event traded through an order book, with a base value of 1 and minting allowed.</description>
            <comision type="on-close">10</comision>
            <GM-options>
                <GM-option>Yes</GM-option>
                <GM-option>No</GM-option>
            </GM-options>
            <GM-method>
                <GM-order-book allow-mint="true" initial="100" d="1"/>
            </GM-method>
        </GM-event>
    </GM-events>
</Guess-Market>
