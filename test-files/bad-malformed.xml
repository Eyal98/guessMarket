<?xml version="1.0" encoding="UTF-8"?>
<!-- The GM-event element is never closed, so this is not XML at all. -->
<Guess-Market>
    <GM-events>
        <GM-event name="Unfinished Event">
            <id>1</id>
            <description>An event whose element was never closed.</description>
            <comision type="on-close">10</comision>
            <GM-options>
                <GM-option>Yes</GM-option>
                <GM-option>No</GM-option>
            </GM-options>
    </GM-events>
	<GM-users>
		<GM-user name="Tester">
			<initial-cash>100000</initial-cash>
			<GM-market-maker>
			<event id="1"/>
			</GM-market-maker>
		</GM-user>
	</GM-users>
</Guess-Market>
