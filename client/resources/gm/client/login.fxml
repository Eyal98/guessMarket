<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  The login screen: a name, and nothing else. The exercise asks for no password and no sign-up.
-->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="gm.client.login.LoginController" styleClass="root-pane">
    <top>
        <VBox styleClass="header">
            <padding>
                <Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/>
            </padding>
            <Label text="Guess Market" styleClass="app-title" maxWidth="Infinity"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="12.0" alignment="CENTER" maxWidth="420.0">
            <Label text="Log in" styleClass="detail-title"/>
            <Label text="Choose a name. If somebody is already using it, you will be asked for another."
                   wrapText="true"/>
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <TextField fx:id="nameField" promptText="Your name" onAction="#onLogIn" HBox.hgrow="ALWAYS"/>
                <Button fx:id="loginButton" text="Log in" onAction="#onLogIn" styleClass="primary-button"
                        defaultButton="true"/>
                <ProgressIndicator fx:id="waiting" prefWidth="22.0" prefHeight="22.0" visible="false"/>
            </HBox>
            <Label fx:id="problemLabel" styleClass="problem" wrapText="true" maxWidth="Infinity"/>
        </VBox>
    </center>
    <bottom>
        <Label fx:id="serverLabel" styleClass="status-bar" maxWidth="Infinity"/>
    </bottom>
</BorderPane>
