<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  The shell after logging in: the title, who is logged in, and the tabs. The Events and Account tabs
  are the two slides of the exercise 3 sketch; the Chat tab is the bonus.
-->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="gm.client.main.MainController" styleClass="root-pane">
    <top>
        <VBox styleClass="header">
            <padding>
                <Insets top="10.0" right="16.0" bottom="10.0" left="16.0"/>
            </padding>
            <Label text="Guess Market" styleClass="app-title" maxWidth="Infinity"/>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="6.0"/>
                </padding>
                <Label fx:id="userLabel" styleClass="file-path"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="logoutButton" text="Log out" onAction="#onLogOut"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab fx:id="eventsTab" text="Events"/>
                <Tab fx:id="accountTab" text="Account"/>
                <Tab fx:id="chatTab" text="Chat"/>
            </tabs>
        </TabPane>
    </center>
    <bottom>
        <Label fx:id="statusLabel" styleClass="status-bar" maxWidth="Infinity"/>
    </bottom>
</BorderPane>
